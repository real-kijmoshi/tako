[Unit]
Description=Tako AI router
After=network-online.target
Wants=network-online.target

[Service]
User=tako
Group=tako
Environment=TAKO_HOME=/var/lib/tako
StateDirectory=tako
StateDirectoryMode=0700
ExecStart=/usr/local/bin/tako run
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tako

[Install]
WantedBy=multi-user.target
